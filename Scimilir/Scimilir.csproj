<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.0</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The Windows app (built with -p:WindowsApp=true, see installer/README.md):
       no black window, an icon by the clock instead. -->
  <PropertyGroup Condition="'$(WindowsApp)' == 'true'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);WINDOWS_APP</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WindowsApp)' != 'true'">
    <Compile Remove="TrayIcon.cs" />
  </ItemGroup>
  <!-- The engine packages carry files for Linux too; a Windows build doesn't need them. -->
  <Target Name="DropOtherSystems" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <RemoveDir Directories="$(PublishDir)runtimes/linux-x64;$(PublishDir)runtimes/linux-arm64;$(PublishDir)runtimes/osx-x64;$(PublishDir)runtimes/osx-arm64" />
  </Target>

  <ItemGroup>
    <!-- LLamaSharp runs model files (.gguf) on this PC. The Cpu backend works
         everywhere; the Vulkan backend lets it use most graphics cards. -->
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.30.0" />
    <!-- Draws the QR code a phone can scan to open Scimilir. -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tray icon reads this file at run time. -->
    <Content Include="icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Older versions kept data here; never build it in. -->
    <Content Remove="data/**" />
    <None Remove="data/**" />
  </ItemGroup>

</Project>
