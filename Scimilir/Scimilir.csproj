<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- LLamaSharp runs model files (.gguf) on this PC. The Cpu backend works
         everywhere; the Vulkan backend lets it use most graphics cards. -->
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.30.0" />
    <!-- Draws the QR code a phone can scan to open Scimilir. -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The data folder holds settings, chats and model files; never build it in. -->
    <Content Remove="data/**" />
    <None Remove="data/**" />
  </ItemGroup>

</Project>
